#!/usr/bin/env python3
"""
verificar_estado_consolidado.py

Script de auditoría para determinar si tu backend puede devolver
el estado consolidado del usuario en una sola llamada.

Uso:
    python verificar_estado_consolidado.py --config config.json
    python verificar_estado_consolidado.py  # usa valores por defecto

Requisitos:
    pip install psycopg2-binary requests sqlalchemy
    (o mysql-connector-python si usas MySQL)
"""

import argparse
import json
import sys
from dataclasses import dataclass, field
from datetime import datetime
from typing import Optional

# ---------------------------------------------------------------------------
# Dependencias opcionales — el script se adapta según lo que esté instalado
# ---------------------------------------------------------------------------

try:
    import psycopg2
    HAS_POSTGRES = True
except ImportError:
    HAS_POSTGRES = False

try:
    import mysql.connector
    HAS_MYSQL = True
except ImportError:
    HAS_MYSQL = False

try:
    import requests
    HAS_REQUESTS = True
except ImportError:
    HAS_REQUESTS = False

try:
    from sqlalchemy import create_engine, inspect, text
    HAS_SQLALCHEMY = True
except ImportError:
    HAS_SQLALCHEMY = False


# ---------------------------------------------------------------------------
# Estructuras de datos
# ---------------------------------------------------------------------------

@dataclass
class Verificacion:
    nombre: str
    estado: str          # "ok", "fallo", "advertencia", "info"
    detalle: str
    recomendacion: str = ""


@dataclass
class Reporte:
    verificaciones: list = field(default_factory=list)
    timestamp: str = field(
        default_factory=lambda: datetime.now().isoformat()
    )

    def agregar(self, v: Verificacion):
        self.verificaciones.append(v)

    def resumen(self) -> dict:
        total = len(self.verificaciones)
        ok = sum(1 for v in self.verificaciones if v.estado == "ok")
        fallos = sum(1 for v in self.verificaciones if v.estado == "fallo")
        advertencias = sum(
            1 for v in self.verificaciones if v.estado == "advertencia"
        )
        return {
            "total": total,
            "ok": ok,
            "fallo": fallos,
            "advertencia": advertencias,
            "puede_consolidar": fallos == 0,
        }


